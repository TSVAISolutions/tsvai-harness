    "build": "tsc",
    "start": "node src/index.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
