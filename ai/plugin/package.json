{
  "name": "@tsvaisolutions/core-plugin",
  "version": "1.0.0",
  "description": "TSVAI Core Plugin - Text analysis and data processing",
  "private": true,
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "TSVAI DevOps Team",
  "license": "MIT",
  "keywords": [
    "plugin",
    "text-analysis",
    "nlp",
    "claude",
    "mcp"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "bin": {
